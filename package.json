{
  "name": "website-personal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run build && webpack-dev-server",
    "build": "npm run lint && npm run format && tsc && webpack",
    "lint": "eslint \"src/**/*.{cjs,mjs,js,jsx,ts,tsx,mts,cts}\" --quiet --fix",
    "format": "prettier --write \"src/**/*.{cjs,mjs,js,jsx,ts,tsx,mts,cts,json,html,css}\"",
    "update": "ncu -u --peer --reject typescript"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "8.x",
    "@babel/core": "8.x",
    "@babel/preset-env": "8.x",
    "@babel/preset-react": "8.x",
    "@babel/preset-typescript": "8.x",
    "@types/lodash": "4.x",
    "@types/react": "19.x",
    "@types/react-dom": "19.x",
    "babel-loader": "10.x",
    "css-loader": "7.x",
    "eslint": "10.6.x",
    "favicons": "7.x",
    "favicons-webpack-plugin": "6.x",
    "html-webpack-plugin": "5.x",
    "npm-check-updates": "22.x",
    "prettier": "3.x",
    "style-loader": "4.x",
    "typescript": "6.x",
    "typescript-eslint": "8.x",
    "url-loader": "4.x",
    "webpack": "5.x",
    "webpack-cli": "7.x",
    "webpack-dev-server": "6.x"
  },
  "dependencies": {
    "react": "19.x",
    "react-dom": "19.x",
    "react-router-dom": "7.x"
  }
}
